# Copy to .env.local and fill in the real values. Never commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ndu team WhatsApp for "Talk to a person at Ndu" (digits only)
NEXT_PUBLIC_TEAM_WHATSAPP=2348136443784

# Cloudflare R2 photo storage
# Public address of the bucket, e.g. https://pub-xxxx.r2.dev (no slash at the end)
NEXT_PUBLIC_MEDIA_URL=
# Server-only secrets (no NEXT_PUBLIC_, so they never reach a phone)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ndu-media
